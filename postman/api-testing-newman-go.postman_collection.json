{
  "info": {
    "_postman_id": "c4e8041e-ff39-4a8e-a249-e0a4b6f12027",
    "name": "API de libros - pruebas funcionales",
    "description": "Pruebas de contrato y flujo CRUD para la API de ejemplo construida con Go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "createdBookId", "value": "" }
  ],
  "item": [
    {
      "name": "Health responde OK",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));", "pm.test('estado es ok', () => pm.expect(pm.response.json().status).to.eql('ok'));" ] } }]
    },
    {
      "name": "Listar libros",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));", "pm.test('devuelve una lista de libros', () => pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty);" ] } }]
    },
    {
      "name": "Consultar libro existente",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books/1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));", "pm.test('el id corresponde al recurso', () => pm.expect(pm.response.json().data.id).to.eql(1));" ] } }]
    },
    {
      "name": "Crear libro",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"El mundo es ancho y ajeno\",\n  \"author\": \"Ciro Alegría\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 201', () => pm.response.to.have.status(201));", "const book = pm.response.json().data;", "pm.test('el libro creado tiene id y título', () => { pm.expect(book.id).to.be.a('number'); pm.expect(book.title).to.eql('El mundo es ancho y ajeno'); });", "pm.collectionVariables.set('createdBookId', book.id);" ] } }]
    },
    {
      "name": "Actualizar libro creado",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"El mundo es ancho y propio\",\n  \"author\": \"Ciro Alegría\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books/{{createdBookId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));", "pm.test('el título actualizado se conserva', () => pm.expect(pm.response.json().data.title).to.eql('El mundo es ancho y propio'));" ] } }]
    },
    {
      "name": "Eliminar libro creado",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/books/{{createdBookId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 204', () => pm.response.to.have.status(204));" ] } }]
    },
    {
      "name": "Validar libro eliminado",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books/{{createdBookId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 404 después de eliminar', () => pm.response.to.have.status(404));" ] } }]
    },
    {
      "name": "Rechazar libro sin título",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"  \",\n  \"author\": \"Autor de prueba\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('responde 400 para datos incompletos', () => pm.response.to.have.status(400));", "pm.test('explica el error', () => pm.expect(pm.response.json().error).to.include('title and author'));" ] } }]
    }
  ]
}
